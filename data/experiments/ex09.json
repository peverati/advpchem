 "quiz": [
  {
   "q": "A total atomization energy is the energy needed to…",
   "options": [
    "break one bond",
    "break a molecule into all of its separate ground-state atoms",
    "form the molecule from the elements in their standard states",
    "ionize the molecule"
   ],
   "answer": 1,
   "explain": "For H₂ it is the same as the bond dissociation energy. For CH₄ it is the sum of all four C–H bond energies, so atomization energies are large numbers."
  },
  {
   "q": "Why is Hartree–Fock expected to do badly for atomization energies?",
   "options": [
    "It has no electron correlation, and correlation is larger in the molecule than in the separated atoms, so bonds come out too weak",
    "It is too expensive",
    "It cannot describe open-shell atoms at all",
    "It overestimates every bond"
   ],
   "answer": 0,
   "explain": "Bringing electrons together into bonds increases the correlation energy, which HF leaves out entirely. The missing correlation is bigger for the molecule, so HF underbinds."
  },
  {
   "q": "The computed ΔE is an electronic energy at fixed nuclei. An experimental bond enthalpy at 298 K also includes…",
   "options": [
    "nothing else; they are the same",
    "zero-point vibrational energy and thermal energy, plus spin–orbit effects for atoms with orbital angular momentum",
    "only the basis-set error",
    "relativistic effects only"
   ],
   "answer": 1,
   "explain": "Going from experiment to the purely electronic value needs several corrections, which is why direct comparisons need care."
  },
  {
   "q": "Which of these species is a radical?",
   "options": [
    "*tert*-butyl alcohol",
    "the OH fragment",
    "methane",
    "water"
   ],
   "answer": 1,
   "explain": "Breaking the C–O bond homolytically leaves one unpaired electron on each fragment: two radicals (doublets)."
  }
 ],
