 "quiz": [
  {
   "q": "What is the integration grid used for in Kohn–Sham DFT?",
   "options": [
    "To place the basis functions",
    "To evaluate the exchange–correlation energy numerically, as a weighted sum over points in space",
    "To optimize the geometry",
    "To compute the Hartree–Fock exchange"
   ],
   "answer": 1,
   "explain": "For almost every functional, the xc energy has no analytic integral over Gaussian basis functions, so it is computed numerically on a grid of points around each atom."
  },
  {
   "q": "A (99,590) grid has…",
   "options": [
    "99 atoms and 590 basis functions",
    "99 radial shells around each atom, each with 590 angular points",
    "590 radial shells with 99 points each",
    "99 × 590 basis functions"
   ],
   "answer": 1,
   "explain": "So about 58,000 points per atom before pruning. Use the grid explorer below to see what that looks like."
  },
  {
   "q": "Why can a coarse grid put wiggles into a dissociation curve?",
   "options": [
    "The grid points move with the atoms, so the numerical integration error changes erratically as the distance changes",
    "The basis set is too small",
    "Argon is a transition metal",
    "The SCF did not converge"
   ],
   "answer": 0,
   "explain": "The error of a numerical integration depends on how the density happens to fall on the points. When the atoms move, that changes from one geometry to the next, adding noise. A tiny binding energy (0.28 kcal/mol here) makes the noise obvious."
  },
  {
   "q": "Which kind of functional is usually the most sensitive to the grid?",
   "options": [
    "LSDA",
    "GGA",
    "meta-GGA (especially heavily parametrized ones)",
    "Hartree–Fock"
   ],
   "answer": 2,
   "explain": "Meta-GGAs depend on the kinetic-energy density τ, which varies rapidly, and parametrized forms can amplify integration noise. HF needs no xc grid at all."
  }
 ],
